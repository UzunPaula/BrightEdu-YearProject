<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\BrightEdu.Application\BrightEdu.Application.csproj" />
      <ProjectReference Include="..\BrightEdu.Domain\BrightEdu.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Services\" />
    </ItemGroup>

    <!-- Patternuri active: Builder, Singleton, Facade (incluse implicit) -->
    <!-- Patternuri excluse: tot restul DesignPatterns -->
    <ItemGroup>
      <Compile Remove="DesignPatterns\Adapter\**" />
      <Compile Remove="DesignPatterns\Composite\**" />
      <Compile Remove="DesignPatterns\Prototype\**" />
      <Compile Remove="Migrations\**" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="DesignPatterns\Adapter\**" />
      <EmbeddedResource Remove="DesignPatterns\Composite\**" />
      <EmbeddedResource Remove="Migrations\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="DesignPatterns\Adapter\**" />
      <None Remove="DesignPatterns\Composite\**" />
      <None Remove="Migrations\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.25" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.25" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.25">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>

</Project>
